node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
.gradle/

# vite
.vite/

# logs
logs/
*.log

# env
.env
.env.*

# databases
*.db
*.sqlite

# editor
.vscode/*
!.vscode/extensions.json
.idea/
/echodeck/client/rebuild.txt

# OS
.DS_Store
Thumbs.db

# electron
*.asar

# capacitor / android
android/.gradle/
android/build/
android/app/build/
android/local.properties
# Unanchored so it matches client/android/keystore.properties — a leading
# path segment here would anchor the pattern to the repo root and miss it.
keystore.properties
*.jks
*.keystore
android/captures/
android/.cxx/

# generated files
coverage/
.cache/
tmp/
temp/

# binaries
*.exe
*.dll

# Electron build output — released via GitHub Actions, not committed to repo
host/dist/

# Local Android build output — released via GitHub Actions, not committed
*.apk

# Fetched at build time by host/scripts/fetch-tools.mjs (~112MB), never committed
host/assets/tools/

# Compiled native addons — built by node-gyp/@electron/rebuild at install time.
# `build/` is already ignored above; `bin/` is where @electron/rebuild caches
# its per-ABI copy, and both are regenerated, never committed.
*.node
host/native/**/bin/
